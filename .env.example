# Скопируйте в .env и при необходимости поменяйте значения
DB_PASSWORD=kontur
JWT_SECRET=change-me-in-production-0123456789abcdef
DEMO_DATA=true

# Порты на хосте, если стандартные заняты
DB_PORT=5432
BACKEND_PORT=8080

# Вход через Google (OpenID Connect). Redirect URI в консоли Google:
#   http://localhost:3000/login/oauth2/code/google
SPRING_PROFILES_ACTIVE=default
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
