# Скопируйте в .env и при необходимости поменяйте значения
DB_PASSWORD=kontur
# В проде — случайная строка не короче 32 символов: openssl rand -base64 48
JWT_SECRET=change-me-in-production-0123456789abcdef
DEMO_DATA=true

# Порты на хосте, если стандартные заняты
DB_PORT=5432
BACKEND_PORT=8080

# Первый администратор для «чистой» установки (DEMO_DATA=false). Пароль — от 12 символов.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Вход через соцсети (OAuth 2.0 / OpenID Connect). Провайдер включается, если заданы оба ключа.
# Redirect URI в консоли провайдера: http://localhost:3000/login/oauth2/code/<google|github|facebook|yandex|linkedin>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
